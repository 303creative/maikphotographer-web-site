<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Journal — Marketing Notes for Miami Brands | The303</title>
<meta name="description" content="Notes on content, marketing and growth for Miami businesses.">
<meta name="robots" content="index,follow">
<link rel="canonical" href="https://www.maikphotographer.com/Journal.dc.html">
<meta name="theme-color" content="#0A0A0A">
<link rel="icon" href="/favicon.ico">
<meta property="og:title" content="Journal — Marketing Notes for Miami Brands | The303">
<meta property="og:description" content="Notes on content, marketing and growth for Miami businesses.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://www.maikphotographer.com/Journal.dc.html">
<meta property="og:image" content="https://www.maikphotographer.com/assets/backgrounds/31_fondo_ia1_oscuro_principal.jpg">
<meta name="twitter:card" content="summary_large_image">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,300..800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
html,body{margin:0;background:#0A0A0A;color:#F2F2F0;-webkit-font-smoothing:antialiased}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
a{color:#F2F2F0;text-decoration:none}
a:hover{color:#FF5A36}
input{font:inherit}
::-webkit-scrollbar{display:none}
</style>
</helmet>
<div style="font-family:'Archivo',sans-serif;background:#0A0A0A;color:#F2F2F0;min-height:100vh;position:relative;overflow-x:hidden;padding-top:73px;padding-bottom:84px;container-type:inline-size">
<div style="position:absolute;inset:0;pointer-events:none;z-index:0;margin:0 clamp(16px,3vw,48px);background-image:linear-gradient(90deg,rgba(242,242,240,.06) 1px,transparent 1px);background-size:25% 100%;border-right:1px solid rgba(242,242,240,.06)"></div>
<dc-import name="SiteHeader" lang="{{ lang }}" on-lang="{{ setLang }}" active="journal" hint-size="100%,73px"></dc-import>

<section data-screen-label="Journal hero" style="position:relative;z-index:1;padding:32px clamp(16px,3vw,48px) 0">
  <div style="display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#8A8A87;margin-bottom:28px"><span>[00] — Journal</span><span>{{ count }} {{ t.entries }}</span></div>
  <h1 style="margin:0;font-weight:600;font-stretch:112%;font-size:clamp(46px,14cqw,176px);line-height:.86;letter-spacing:-.045em;text-transform:uppercase">{{ t.h1a }}<br><span style="color:#5C5C5A">{{ t.h1b }}</span></h1>
  <p style="margin:28px 0 0;font-family:'IBM Plex Mono',monospace;font-size:12px;line-height:1.6;color:#B4B4B0;max-width:520px">{{ t.intro }}</p>
</section>

<section data-screen-label="Featured" style="position:relative;z-index:1;padding:48px clamp(16px,3vw,48px) 0">
  <a href="JournalArticle.dc.html" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:0;border:1px solid rgba(242,242,240,.2)">
    <div style="position:relative;aspect-ratio:4/3;overflow:hidden;background:#161616">
      <img src="https://www.maikphotographer.com/assets/portfolio/39_portafolio_1.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(1.05) contrast(1.03)">
      <span style="position:absolute;left:10px;top:10px;font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;background:#FF5A36;color:#0A0A0A;padding:4px 6px">{{ t.featured }}</span>
    </div>
    <div style="padding:20px;display:flex;flex-direction:column;justify-content:space-between;gap:24px">
      <div style="display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#8A8A87"><span>01. {{ first.cat }}</span><span>{{ first.read }}</span></div>
      <h2 style="margin:0;font-weight:600;font-stretch:112%;font-size:clamp(30px,8cqw,64px);line-height:.92;letter-spacing:-.035em;text-transform:uppercase">{{ first.title }}</h2>
      <p style="margin:0;font-family:'IBM Plex Mono',monospace;font-size:12px;line-height:1.6;color:#B4B4B0">{{ first.dek }}</p>
      <span style="display:flex;justify-content:space-between;align-items:center;height:48px;border-top:1px solid rgba(242,242,240,.2);font-size:12px;text-transform:uppercase;letter-spacing:.04em"><span>{{ t.read }}</span><span>↗</span></span>
    </div>
  </a>
</section>

<section data-screen-label="Index" style="position:relative;z-index:1;padding:64px clamp(16px,3vw,48px) 0">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap">
    <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#8A8A87">[01] {{ t.index }} •</div>
    <div style="display:flex;gap:6px;overflow-x:auto">
      <sc-for list="{{ cats }}" as="c" hint-placeholder-count="4">
        <button onClick="{{ c.onClick }}" style="{{ c.style }}">{{ c.label }}</button>
      </sc-for>
    </div>
  </div>
  <div style="border-top:1px solid rgba(242,242,240,.3)">
    <sc-for list="{{ posts }}" as="p" hint-placeholder-count="5">
      <a href="{{ p.href }}" style="display:grid;grid-template-columns:44px minmax(0,1fr) 72px;gap:12px;align-items:start;padding:18px 0;border-bottom:1px solid rgba(242,242,240,.3)">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:#8A8A87;padding-top:3px">{{ p.n }}.</span>
        <span style="display:flex;flex-direction:column;gap:8px;min-width:0">
          <span style="font-weight:500;font-stretch:104%;font-size:clamp(18px,5cqw,30px);line-height:1.1;text-transform:uppercase;letter-spacing:-.02em">{{ p.title }}</span>
          <span style="display:flex;gap:12px;flex-wrap:wrap;font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:#8A8A87"><span>{{ p.cat }}</span><span>{{ p.read }}</span><span style="{{ p.statusStyle }}">{{ p.status }}</span></span>
        </span>
        <span style="position:relative;aspect-ratio:1;overflow:hidden;background:#161616">
          <img src="{{ p.img }}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(1.05) contrast(1.03)">
        </span>
      </a>
    </sc-for>
  </div>
</section>

<dc-import name="AuditBlock" lang="{{ lang }}" index="02" source="journal" style="margin-top:88px" hint-size="100%,900px"></dc-import>
<dc-import name="SiteFooter" lang="{{ lang }}" audit-href="#audit" hint-size="100%,600px"></dc-import>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;lang&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;en&quot;,&quot;es&quot;],&quot;default&quot;:&quot;en&quot;,&quot;tsType&quot;:&quot;'en'|'es'&quot;}}">
const IMG = n => `https://www.maikphotographer.com/assets/portfolio/39_portafolio_${n}.jpg`;
const POSTS = {
en:[
['content','Brand content that sells: what Miami businesses get wrong','Why most brand photos never turn into bookings, and how to plan a shoot around the sale instead of the feed.','6 min','live','/blog-brand-content-photography',1],
['realestate','Listing content for Miami real estate: photo, video and Reels','A shot list and distribution plan that helps a listing stand out in Brickell and Coral Gables.','— min','draft','',6],
['hospitality','Content for restaurants and hotels that fills tables and rooms','What to shoot, how often to post, and how to measure if it is bringing guests.','— min','draft','',3],
['content','Editorial direction for brands: from portrait to campaign','Reframed from "Editorial photographer Miami": how editorial direction raises the perceived value of a brand.','5 min','live','/blog-editorial-photographer-miami',9],
['events','Courthouse weddings in Miami: an events content case','Reframed from the original post as an events-and-hospitality content piece.','4 min','live','/blog-courthouse-wedding-miami',8]],
es:[
['content','Contenido de marca que vende: en qué se equivocan los negocios de Miami','Por qué la mayoría de fotos de marca nunca se convierten en reservas, y cómo planificar una sesión pensando en la venta y no en el feed.','6 min','live','/blog-brand-content-photography',1],
['realestate','Contenido para real estate en Miami: foto, video y Reels','Un shot list y un plan de distribución para que un listing destaque en Brickell y Coral Gables.','— min','draft','',6],
['hospitality','Contenido para restaurantes y hoteles que llena mesas y habitaciones','Qué grabar, cada cuánto publicar y cómo medir si trae clientes.','— min','draft','',3],
['content','Dirección editorial para marcas: del retrato a la campaña','Reformulado desde "Editorial photographer Miami": cómo la dirección editorial sube el valor percibido de una marca.','5 min','live','/blog-editorial-photographer-miami',9],
['events','Bodas civiles en Miami: un caso de contenido para eventos','Reformulado desde el post original como pieza de contenido para eventos y hospitality.','4 min','live','/blog-courthouse-wedding-miami',8]]
};
const T = {
en:{h1a:'Notes on',h1b:'content that sells.',intro:'Marketing for Miami businesses: real estate, hospitality and brand content built to book clients.',entries:'entries',featured:'Featured',read:'Read article',index:'Index',
cats:{all:'All',content:'Brand content',realestate:'Real estate',hospitality:'Hospitality',events:'Events'},live:'Published',draft:'Draft'},
es:{h1a:'Notas sobre',h1b:'contenido que vende.',intro:'Marketing para negocios de Miami: real estate, hospitality y contenido de marca pensado para conseguir clientes.',entries:'entradas',featured:'Destacado',read:'Leer artículo',index:'Índice',
cats:{all:'Todo',content:'Contenido de marca',realestate:'Real estate',hospitality:'Hospitality',events:'Eventos'},live:'Publicado',draft:'Borrador'}
};
class Component extends DCLogic {
  state = { lang: (()=>{try{return localStorage.getItem('t303-lang')}catch(e){return null}})(), cat:'all' };
  setLang = l => { try{localStorage.setItem('t303-lang',l)}catch(e){} this.setState({lang:l}); };
  renderVals() {
    const lang = this.state.lang ?? this.props.lang ?? 'en';
    const t = T[lang]; const c = this.state.cat;
    const chip = on => ({flex:'none', background: on ? '#F2F2F0' : 'transparent', color: on ? '#0A0A0A' : '#F2F2F0', border:'1px solid ' + (on ? '#F2F2F0' : 'rgba(242,242,240,.3)'), height:36, padding:'0 12px', cursor:'pointer', fontFamily:"'IBM Plex Mono',monospace", fontSize:10, letterSpacing:'.08em', textTransform:'uppercase'});
    const all = POSTS[lang].map(([cat,title,dek,read,status,slug,img],i) => ({cat:t.cats[cat], key:cat, title, dek, read, status:t[status], img:IMG(img), n:String(i+1).padStart(2,'0'),
      href: 'JournalArticle.dc.html',
      statusStyle:{color: status==='draft' ? '#FF5A36' : '#8A8A87'}}));
    return { t, lang, setLang: this.setLang, first: all[0], count: String(all.length).padStart(2,'0'),
      cats: Object.keys(t.cats).map(k => ({label:t.cats[k], style:chip(c===k), onClick:()=>this.setState({cat:k})})),
      posts: all.filter(p => c==='all' || p.key===c) };
  }
}
</script>
<script type="module" src="/js/mariela-widget.js"></script>
</body>
</html>
